{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/new-drug-reimbursement-game/schemas/parameter-evidence-candidate-dossier-v1.schema.json",
  "title": "Candidate-only methodological parameter evidence dossier",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dossier_kind", "dossier_id", "context", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "dossier_kind": {"const": "parameter-evidence-candidates"},
    "dossier_id": {"type": "string", "minLength": 1},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["jurisdiction", "payer", "budget_boundary", "currency_unit", "health_unit"],
      "properties": {
        "jurisdiction": {"type": "string", "minLength": 1},
        "payer": {"type": "string", "minLength": 1},
        "budget_boundary": {"type": "string", "minLength": 1},
        "currency_unit": {"type": "string", "minLength": 1},
        "health_unit": {"type": "string", "minLength": 1}
      }
    },
    "candidates": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"value": {"type": "null"}}, "required": ["value"]},
          "then": {
            "properties": {
              "kind": {"const": "method_guidance"},
              "roles_considered": {
                "prefixItems": [{"const": "horizon"}],
                "minItems": 1,
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {"properties": {"roles_considered": {"minItems": 2}}, "required": ["roles_considered"]},
          "then": {"properties": {"roles_considered": {"items": {"enum": ["n", "m"]}, "maxItems": 2}}}
        },
        {
          "if": {"properties": {"roles_considered": {"contains": {"enum": ["n", "d", "m", "mu"]}}}, "required": ["roles_considered"]},
          "then": {"properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"pattern": "^[^/]+/[^/]+$"}}}
        },
        {
          "if": {"properties": {"roles_considered": {"contains": {"const": "phi"}}}, "required": ["roles_considered"]},
          "then": {"properties": {"value": {"type": "number", "exclusiveMinimum": 1}, "unit": {"const": "dimensionless"}}}
        },
        {
          "if": {"properties": {"roles_considered": {"contains": {"const": "annual_program_health_effect"}}}, "required": ["roles_considered"]},
          "then": {"properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "unit": {"pattern": "/year$"}}}
        },
        {
          "if": {"properties": {"roles_considered": {"contains": {"const": "horizon"}}}, "required": ["roles_considered"]},
          "then": {"properties": {"value": {"anyOf": [{"type": "number", "exclusiveMinimum": 0, "multipleOf": 1}, {"type": "null"}]}, "unit": {"const": "year"}}}
        },
        {
          "if": {"properties": {"roles_considered": {"contains": {"const": "discount_rate"}}}, "required": ["roles_considered"]},
          "then": {"properties": {"value": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}, "unit": {"const": "proportion/year"}}}
        }
      ],
      "required": ["candidate_id", "kind", "value", "unit", "price_year", "study_period", "programme_id", "alignment_id", "roles_considered", "estimand", "geographic_scope", "budget_scope", "evidence_method", "uncertainty_status", "transformation", "assumptions", "mapping_limitations", "approval_state", "source"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["policy_proxy", "research_estimate", "method_guidance"]},
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "price_year": {"type": ["integer", "null"], "minimum": 1900},
        "study_period": {"type": ["string", "null"], "minLength": 1},
        "programme_id": {"type": ["string", "null"], "minLength": 1},
        "alignment_id": {"type": ["string", "null"], "minLength": 1},
        "roles_considered": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["n", "d", "m", "mu", "phi", "annual_program_health_effect", "horizon", "discount_rate"]}},
        "estimand": {"type": "string", "minLength": 1},
        "geographic_scope": {"type": "string", "minLength": 1},
        "budget_scope": {"type": "string", "minLength": 1},
        "evidence_method": {"type": "string", "minLength": 1},
        "uncertainty_status": {"enum": ["not_quantified", "point_only", "distribution_available"]},
        "transformation": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mapping_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "approval_state": {"const": "candidate"},
        "source": {
          "type": "object", "additionalProperties": false,
          "required": ["uri", "sha256", "artifact_kind", "exact_location"],
          "properties": {
            "uri": {"type": "string", "format": "uri", "pattern": "^https://"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "artifact_kind": {"type": "string", "minLength": 1},
            "exact_location": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
